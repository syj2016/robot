<?xml version="1.0"?>
<robot name="two_link_arm">

  <!-- Base 底座 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.2"/></geometry>

    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- 关节1：基座到大臂，origin z改成0.1，对齐底座顶面 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <!-- 大臂 link1 -->
  <link name="link1">
    <visual>
      <geometry><box size="0.1 0.1 0.5"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="0.1 0.1 0.5"/></geometry>
      <origin xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- 关节2：大臂到小臂，这个坐标是对的 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="1.0"/>
  </joint>

  <!-- 小臂 link2，末端带相机 -->
  <link name="link2">
    <visual>
      <geometry><box size="0.08 0.08 0.4"/></geometry>
      <origin xyz="0 0 0.2"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.4"/></geometry>
      <origin xyz="0 0 0.2"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Gazebo 相机传感器 -->
  <gazebo reference="link2">
    <sensor type="camera" name="arm_camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
      </camera>
    </sensor>
  </gazebo>

  <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="blue"><color rgba="0 0 1 1"/></material>
  <material name="green"><color rgba="0 1 0 1"/></material>
</robot>