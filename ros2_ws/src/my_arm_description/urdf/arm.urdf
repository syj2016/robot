<?xml version="1.0"?>
<robot name="two_link_arm">

  <!-- Base 底座 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.4 0.2"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.4 0.4 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- 关节1：基座到大臂，origin z改成0.1，对齐底座顶面 -->
